# Copy to .env and fill in. Never commit .env.
# Dev Postgres (compose.dev.yaml). Choose your own password.
AP_DB_USER=ap
AP_DB_PASSWORD=change-me
AP_DB_NAME=ap
AP_DB_PORT=5433
AP_DATABASE_URL=postgresql://ap:change-me@127.0.0.1:5433/ap

# Model runtime (config/models.yaml reads these)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODE=live            # live | replay

# Azure OpenAI, later only. Leave empty for the demo.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Review app -> Airflow REST trigger (CR-004; SimpleAuthManager, local only).
# Leave empty when the login setup is off: the Upload page then shows a link to Airflow.
AIRFLOW_BASE_URL=http://127.0.0.1:8080
AIRFLOW_DAG_ID=invoice_intake
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_AUTH_TOKEN=
