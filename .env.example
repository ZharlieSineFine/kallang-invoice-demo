# Copy to .env and fill in. Never commit .env.
# Dev Postgres (compose.dev.yaml). Choose your own password.
AP_DB_USER=ap
AP_DB_PASSWORD=change-me
AP_DB_NAME=ap
AP_DB_PORT=5433
AP_DATABASE_URL=postgresql://ap:change-me@127.0.0.1:5433/ap

# Model runtime (config/models.yaml reads these)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODE=live            # live | replay

# Azure OpenAI, later only. Leave empty for the demo.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
